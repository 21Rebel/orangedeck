# Farben -- dieselbe HCL-Rechnung wie ui/qml/colors.js
# --------------------------------------------------------------------------

ORANGE = (0.181, 0.472)
TEAL = (0.475, 0.55)
PURPLE = (0.95, 0.35)
CHROMA = 78.225
XN, YN, ZN = 0.96422, 1, 0.82521
T0, T1 = 4 / 29, 6 / 29
T2 = 3 * T1 * T1


def hcl_rgb(h01, l01):
    """Nachbau von hclToCss() in colors.js, also von d3-color. Gerundet wird
    wie Math.round (halb nach oben), nicht wie Pythons round(). Am 12.09.2026
    fuer alle zehn Gebuehrenklassen und Orange gegen colors.js unter node
    gehalten: gleich."""
    h = math.radians(h01 * 360)
    lum = l01 * 150
    a = math.cos(h) * CHROMA
    b = math.sin(h) * CHROMA
    y = (lum + 16) / 116
    x = y + a / 500
    z = y - b / 200

    def lab2xyz(v):
        return v * v * v if v > T1 else T2 * (v - T0)

    x, y, z = XN * lab2xyz(x), YN * lab2xyz(y), ZN * lab2xyz(z)

    def kanal(v):
        v = 12.92 * v if v <= 0.0031308 else 1.055 * math.pow(v, 1 / 2.4) - 0.055
        return max(0, min(255, math.floor(255 * v + 0.5)))

    return (kanal(3.1338561 * x - 1.6168667 * y - 0.4906146 * z),
            kanal(-0.9787684 * x + 1.9161415 * y + 0.0334540 * z),
            kanal(0.0719453 * x - 0.2289914 * y + 1.4052427 * z))


def gebuehr_farbe(rate):
    """feeColorForRate(): teal -> purple ueber log2(sat/vB) von 1 bis 7;
    keine Gebuehr ist orange."""
    if not rate or rate <= 0:
        return hcl_rgb(*ORANGE)
    lo, hi = 1, math.log2(128)
    dx = max(0.0, min(1.0, (math.log2(rate) - lo) / (hi - lo)))
    return hcl_rgb(TEAL[0] + dx * (PURPLE[0] - TEAL[0]),
                   TEAL[1] + dx * (PURPLE[1] - TEAL[1]))


