def zahl(n, stellen=0):
    """Tausendertrennung in der Schreibweise der Sprache. "1.234" heisst auf
    Deutsch tausendzweihundertvierunddreissig, auf Englisch eins Komma zwei --
    dieselbe Regel wie `Tr.group` in der App."""
    if n is None:
        return "–"
    s = "{:,.{}f}".format(float(n), stellen)
    if LANG == "de":
        s = s.replace(",", "\0").replace(".", ",").replace("\0", ".")
    return s


def gebuehr(v):
    """sat/vB: unter 10 mit zwei Stellen, darueber mit einer -- 0,41 und 12,3."""
    if v is None:
        return "–"
    return zahl(v, 2 if v < 10 else 1)


def prozent(v, vorzeichen=False):
    if v is None:
        return "–"
    s = zahl(v, 2)
    if vorzeichen and v > 0:
        s = "+" + s
    return s + " %"


def dauer(sekunden):
    if sekunden is None:
        return "–"
    s = max(0, int(sekunden))
    tage, rest = divmod(s, 86400)
    std, rest = divmod(rest, 3600)
    minuten = rest // 60
    if LANG == "de":
        if tage:
            return "%d T %d Std" % (tage, std)
        if std:
            return "%d Std %d min" % (std, minuten)
        return "%d min" % minuten if minuten else "%d s" % s
    if tage:
        return "%dd %dh" % (tage, std)
    if std:
        return "%dh %dm" % (std, minuten)
    return "%d min" % minuten if minuten else "%ds" % s


def einheit(wert, basis, einheiten):
    """945234754764331400000 H/s -> (945,23, "EH/s")."""
    if not wert:
        return None, einheiten[0]
    i = 0
    while wert >= basis and i < len(einheiten) - 1:
        wert /= basis
        i += 1
    return wert, einheiten[i]


def hashrate_text(hs):
    v, e = einheit(hs, 1000, ("H/s", "kH/s", "MH/s", "GH/s", "TH/s", "PH/s", "EH/s", "ZH/s"))
    return "–" if v is None else "%s %s" % (zahl(v, 1 if v < 100 else 0), e)


def schwierigkeit_text(d):
    v, e = einheit(d, 1000, ("", "k", "M", "G", "T", "P"))
    return "–" if v is None else "%s %s" % (zahl(v, 2), e)


