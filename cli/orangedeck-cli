# Kurzbefehle einrichten
# --------------------------------------------------------------------------

def belegt(name, ziel, selbst):
    """Warum ein Name nicht frei ist, oder None. Geprueft wird, was beim
    Tippen gewinnen wuerde: ein anderes Programm im PATH, ein Builtin oder eine
    Funktion der Shell. `block` ist in fish eingebaut -- deshalb heisst der
    Explorer-Befehl `blockinfo`."""
    gefunden = shutil.which(name)
    if gefunden and os.path.realpath(gefunden) != selbst:
        return gefunden
    for shell in ("fish", "bash", "zsh"):
        if not shutil.which(shell):
            continue
        try:
            art = subprocess.run([shell, "-c", "type -t %s" % name if shell != "zsh"
                                  else "whence -w %s" % name],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            continue
        art = art.split(":")[-1].strip()
        if art in ("builtin", "function", "keyword", "alias", "reserved"):
            return "%s: %s" % (shell, art)
    if os.path.lexists(ziel) and os.path.realpath(ziel) != selbst:
        return ziel
    return None


def aliases(args, entfernen=False):
    selbst = os.path.realpath(__file__)
    prefix = os.path.expanduser(args.prefix)
    if not entfernen and not args.dry_run:
        os.makedirs(prefix, exist_ok=True)
    for name in NAMES:
        ziel = os.path.join(prefix, name)
        unser = os.path.islink(ziel) and os.path.realpath(ziel) == selbst
        if entfernen:
            if unser:
                if not args.dry_run:
                    os.remove(ziel)
                print(t("alias_wuerde_weg" if args.dry_run else "alias_weg", ziel))
            continue
        if unser:
            print(t("alias_da", ziel))
            continue
        grund = belegt(name, ziel, selbst)
        if grund:
            print(t("alias_belegt", name, grund))
            continue
        if not args.dry_run:
            os.symlink(selbst, ziel)
        print(t("alias_wuerde" if args.dry_run else "alias_neu", ziel))
    if args.dry_run:
        print(t("trocken"))
    pfade = [os.path.realpath(p) for p in os.environ.get("PATH", "").split(os.pathsep) if p]
    if not entfernen and os.path.realpath(prefix) not in pfade:
        print(t("alias_pfad", prefix))
    return 0


# --------------------------------------------------------------------------

def parser_fuer(name):
    p = argparse.ArgumentParser(prog=name)
    p.add_argument("--json", action="store_true", help="JSON statt Text")
    p.add_argument("--raw", action="store_true", help="nur der Wert, fuer Leisten")
    p.add_argument("--watch", nargs="?", const=0, type=float, metavar="SEK",
                   help="wiederholen und bei Aenderung neu ausgeben")
    p.add_argument("--source", choices=("auto", "daemon", "direct"), default="auto")
    p.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    if name in ("price", "btcfetch"):
        p.add_argument("--cur", choices=[k.lower() for k in CURRENCIES])
    if name == "fees":
        p.add_argument("--fee", choices=[k for k, _ in FEE_ZEILEN],
                       help="welcher Wert bei --raw")
    return p


def hilfe():
    print(__doc__.split("\n\n")[0])
    print()
    print("  " + "  ".join(NAMES))
    print()
    print("  orangedeck-cli install-aliases [--prefix DIR] [--dry-run]")
    print("  orangedeck-cli remove-aliases  [--prefix DIR] [--dry-run]")
    print("  <befehl> [--json | --raw] [--watch [SEK]] [--source auto|daemon|direct]")


def main(argv):
    aufruf = os.path.basename(argv[0])
    rest = argv[1:]
    if aufruf in BEFEHLE:
        name = aufruf
    elif rest and not rest[0].startswith("-"):
        name, rest = rest[0], rest[1:]
    else:
        hilfe()
        return 0 if (not rest or rest[0] in ("-h", "--help")) else 2

    if name in ("install-aliases", "remove-aliases"):
        p = argparse.ArgumentParser(prog="orangedeck-cli " + name)
        p.add_argument("--prefix", default="~/.local/bin")
        p.add_argument("--dry-run", action="store_true")
        return aliases(p.parse_args(rest), entfernen=(name == "remove-aliases"))

    if name not in BEFEHLE:
        sys.stderr.write("orangedeck-cli: %s?\n" % name)
        hilfe()
        return 2

    args = parser_fuer(name).parse_args(rest)
    try:
        return ausfuehren(name, args)
    except Fehler as e:
        sys.stderr.write(str(e) + "\n")
        return e.code
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        # `blockheight --raw | true` -- das Ende der Leitung ist kein Fehler.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
