def cmd_btcfetch(lage, args, c):
    tip, f, m, p = lage["tip"], lage["fees"], lage["mempool"], lage["price"]
    d, hr = lage["difficulty"], lage["hashrate"]
    cur = (args.cur or "usd").lower()
    h = tip.get("height") or 0
    rest = ((h // HALVING_INTERVAL + 1) * HALVING_INTERVAL - h) if h else None
    orange = hcl_rgb(*ORANGE)

    def z(name, wert):
        return c(name + ":", orange, fett=True) + " " + wert

    quelle = t("dienst") if lage.quelle == "daemon" else t("direkt", lage.quelle.split(":", 1)[1])
    rechts = [
        c("orangedeck", orange, fett=True) + c("@", GRAU) + c("bitcoin", orange, fett=True),
        c("─" * 22, GRAU),
        z(t("block"), "%s (%s%s)" % (zahl(h), seit(tip.get("time")),
                                     ", " + tip["pool"] if tip.get("pool") else "")),
        z(t("gebuehren"), "%s / %s / %s sat/vB" % (gebuehr(f.get("fastest")), gebuehr(f.get("halfHour")),
                                                  gebuehr(f.get("hour")))),
        z(t("mempool"), "%s tx · %s MvB" % (zahl(m.get("count")),
                                            zahl((m.get("vsize") or 0) / 1e6, 1))),
        z(t("kurs"), "%s %s" % (zahl(p.get(cur)), cur.upper())),
        z(t("hashrate"), hashrate_text(hr.get("current"))),
        z(t("anpassung"), "%s · %s" % (prozent(d.get("progress")), t("erwartet", prozent(d.get("change"), True)))),
        z(t("halving"), t("noch", zahl(rest))),
        z(t("quelle"), quelle),
        "",
        "".join(c("███", gebuehr_farbe(r)) for r in (0, 0.7, 1.5, 2.5, 4, 6.5, 11, 22, 55, 150)),
    ]
    zeilen = []
    for i in range(max(len(LOGO), len(rechts))):
        links = c(LOGO[i], orange, fett=True) if i < len(LOGO) else " " * len(LOGO[0])
        zeilen.append("%s  %s" % (links, rechts[i] if i < len(rechts) else ""))
    daten = {"tip": tip, "fees": f, "mempool": m, "price": p, "difficulty": d,
             "hashrate": {"current": hr.get("current")}, "halvingBlocksLeft": rest,
             "source": lage.quelle}
    # --raw ist hier eine Zeile fuer die Leiste -- und die liest ein Mensch,
    # also bewusst in seiner Schreibweise, anders als die Zahlen der anderen.
    einzeilig = "₿ %s · %s sat/vB · %s %s" % (zahl(h), gebuehr(f.get("fastest")), zahl(p.get(cur)), cur.upper())
    return "\n".join(zeilen), einzeilig, daten


