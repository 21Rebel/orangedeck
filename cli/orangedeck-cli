# Ausfuehren, auch mit --watch
# --------------------------------------------------------------------------

def ausgabe(name, args, c):
    funktion, felder = BEFEHLE[name]
    lage = hole(felder, args.source)
    mensch, roh, daten = funktion(lage, args, c)
    if args.json:
        if isinstance(daten, dict):
            daten = dict(daten, source=lage.quelle)
        eingerueckt = 2 if (sys.stdout.isatty() and args.watch is None) else None
        text = json.dumps(daten, ensure_ascii=False, indent=eingerueckt)
    elif args.raw:
        # Fuer Leisten und Skripte: ohne Tausendertrennung, mit Punkt.
        text = "" if roh is None else str(roh)
    else:
        text = mensch
    return text, lage


def leitung_zu():
    """Liest noch jemand? Mit --watch schreibt ein Befehl nur bei einer
    Aenderung -- `blockheight --watch --raw | head -1` hing deshalb bis zum
    naechsten Block, weil erst das naechste Schreiben den Bruch bemerkt haette
    (am 12.09.2026 im eigenen Test haengen geblieben). poll() meldet das
    geschlossene Leseende sofort."""
    try:
        p = select.poll()
        p.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
        return any(ev & (select.POLLERR | select.POLLHUP) for _, ev in p.poll(0))
    except (OSError, ValueError, AttributeError):
        return False


def ausfuehren(name, args):
    c = Farbe("never" if (args.json or args.raw) else args.color)
    if args.watch is None:
        text, _ = ausgabe(name, args, c)
        print(text)
        return 0

    zuletzt = None
    gewarnt = False
    while True:
        try:
            text, lage = ausgabe(name, args, c)
            fehler = None
        except Fehler as e:
            text, lage, fehler = None, None, e
        if fehler:
            sys.stderr.write(str(fehler) + "\n")
        elif text != zuletzt:
            if not (args.json or args.raw) and sys.stdout.isatty():
                sys.stdout.write("\x1b[H\x1b[2J")
            print(text, flush=True)
            zuletzt = text

        direkt = lage is None or lage.quelle != "daemon"
        untergrenze = WATCH_MIN_DIENST
        if direkt:
            untergrenze = WATCH_MIN_LANGSAM if name in LANGSAM else WATCH_MIN_DIREKT
        wunsch = args.watch or untergrenze
        if wunsch < untergrenze and not gewarnt:
            sys.stderr.write(t("untergrenze", zahl(wunsch), zahl(untergrenze)) + "\n")
            gewarnt = True
        # In Sekundenschritten warten, damit ein geschlossenes Leseende nicht
        # erst nach einer halben Stunde auffaellt.
        ende = time.time() + max(wunsch, untergrenze)
        while time.time() < ende:
            if leitung_zu():
                return 0
            time.sleep(min(1.0, max(0.0, ende - time.time())))


