# --------------------------------------------------------------------------

def balken(anteil, breite, c, farbe):
    voll = int(round(max(0.0, min(1.0, anteil)) * breite))
    return c("█" * voll, farbe) + c("░" * (breite - voll), GRAU)


def kurve(werte, c, farbe):
    """Verlauf in einer Zeile. Skaliert auf den eigenen Bereich, nicht auf
    null -- sonst ist eine Hashrate zwischen 880 und 1020 EH/s ein Strich."""
    werte = [w for w in (werte or []) if w]
    if len(werte) < 2:
        return ""
    lo, hi = min(werte), max(werte)
    zeichen = "▁▂▃▄▅▆▇█"
    spanne = (hi - lo) or 1
    return c("".join(zeichen[min(7, int((w - lo) / spanne * 8))] for w in werte), farbe)


def zeile(c, beschriftung, wert, breite=16):
    return c(beschriftung.ljust(breite), GRAU) + wert


def seit(ts):
    return t("vor", dauer(time.time() - ts)) if ts else "–"


# --------------------------------------------------------------------------
# Befehle. Jeder nennt, welche Felder er braucht, und gibt fuer die drei
# Ausgabearten zurueck: (Mensch, --raw, --json).
# --------------------------------------------------------------------------

def cmd_blockheight(lage, args, c):
    tip = lage["tip"]
    h = tip.get("height")
    teile = [c("₿ " + zahl(h), hcl_rgb(*ORANGE), fett=True), seit(tip.get("time"))]
    if tip.get("pool"):
        teile.append(tip["pool"])
    mensch = c("  ·  ", GRAU).join(teile)
    return mensch, h, {"height": h, "time": tip.get("time"), "pool": tip.get("pool"),
                       "nTx": tip.get("nTx"), "medianFee": tip.get("medianFee")}


FEE_ZEILEN = (("fastest", "schnell"), ("halfHour", "halbe"), ("hour", "stunde"),
              ("economy", "sparsam"), ("minimum", "minimal"))


def cmd_fees(lage, args, c):
    f = lage["fees"]
    zeilen = []
    for schluessel, text in FEE_ZEILEN:
        v = f.get(schluessel)
        farbe = gebuehr_farbe(v)
        zeilen.append(zeile(c, t(text), c("■ ", farbe) + c(gebuehr(v), farbe, fett=True) + " sat/vB"))
    wahl = args.fee or "fastest"
    return "\n".join(zeilen), f.get(wahl), f


def cmd_mempool(lage, args, c):
    m, proj, vbps = lage["mempool"], lage.felder.get("projected") or [], lage.felder.get("vbps")
    vsize = m.get("vsize")
    zeilen = [zeile(c, t("mempool"), c(t("unbestaetigt", zahl(m.get("count"))), hcl_rgb(*ORANGE), fett=True))]
    if vsize:
        zeilen.append(zeile(c, t("groesse"), "%s MvB  %s" % (
            zahl(vsize / 1e6, 1), c("(" + t("bloecke_etwa", zahl(math.ceil(vsize / 1e6))) + ")", GRAU))))
    if m.get("totalFee") is not None:
        zeilen.append(zeile(c, t("gebuehren"), "%s BTC" % zahl(m["totalFee"] / 1e8, 4)))
    if vbps:
        zeilen.append(zeile(c, t("zufluss"), "%s vB/s" % zahl(vbps)))
    if proj:
        kacheln = "".join(c("■", gebuehr_farbe(b.get("medianFee"))) for b in proj)
        zeilen.append(zeile(c, t("geplant"), "%s  %s … %s sat/vB" % (
            kacheln, gebuehr(proj[0].get("medianFee")), gebuehr(proj[-1].get("medianFee")))))
    daten = dict(m, vbps=vbps, projectedBlocks=len(proj))
    return "\n".join(zeilen), m.get("count"), daten


def cmd_price(lage, args, c):
    p = lage["price"]
    cur = (args.cur or "usd").lower()
    wert = p.get(cur)
    mensch = "%s  %s %s" % (c("₿ 1 =", GRAU), c(zahl(wert), hcl_rgb(*ORANGE), fett=True), cur.upper())
    return mensch, wert, {"cur": cur, "price": wert, "all": p}


def cmd_difficulty(lage, args, c):
    d, hr = lage["difficulty"], lage["hashrate"]
    anteil = (d.get("progress") or 0) / 100
    change = d.get("change")
    farbe = GRUEN if (change or 0) >= 0 else ROT
    zeilen = [zeile(c, t("anpassung"), "%s %s" % (balken(anteil, 24, c, hcl_rgb(*ORANGE)),
                                                  prozent(d.get("progress"))))]
    rest = d.get("remainingTime")
    wann = ""
    if d.get("retargetDate"):
        wann = " (%s)" % tag_monat(d["retargetDate"] / 1000)
    zeilen.append(zeile(c, "", "%s · %s%s" % (t("in_bloecken", zahl(d.get("remainingBlocks"))),
                                               dauer(rest / 1000 if rest else None), wann)))
    zeilen.append(zeile(c, "", "%s  %s" % (c(t("erwartet", prozent(change, True)), farbe, fett=True),
                                            c(t("zuletzt", prozent(d.get("previousChange"), True)), GRAU))))
    if hr.get("difficulty"):
        zeilen.append(zeile(c, t("schwierigkeit"), schwierigkeit_text(hr["difficulty"])))
    roh = round(change, 2) if change is not None else None
    return "\n".join(zeilen), roh, dict(d, difficulty=hr.get("difficulty"))


def cmd_hashrate(lage, args, c):
    hr = lage["hashrate"]
    aktuell = hr.get("current")
    zeilen = [zeile(c, t("hashrate"), c(hashrate_text(aktuell), hcl_rgb(*ORANGE), fett=True))]
    k = kurve(hr.get("series"), c, hcl_rgb(*ORANGE))
    if k:
        zeilen.append(zeile(c, t("tage30"), k))
    return "\n".join(zeilen), int(aktuell) if aktuell else None, {
        "current": aktuell, "series": hr.get("series")}


def cmd_halving(lage, args, c):
    h = lage["tip"].get("height") or 0
    ziel = (h // HALVING_INTERVAL + 1) * HALVING_INTERVAL if h else None
    rest = ziel - h if ziel else None
    # Mittlere Blockzeit aus der laufenden Periode, sonst die Sollzeit.
    schnitt = (lage["difficulty"].get("timeAvg") or 600000) / 1000
    jetzt_btc = 50 / 2 ** (h // HALVING_INTERVAL) if h else None
    zeilen = [zeile(c, t("halving"), "%s  %s" % (
        c(t("noch", zahl(rest)), hcl_rgb(*ORANGE), fett=True), c(t("bei", zahl(ziel)), GRAU)))]
    if rest:
        zeilen.append(zeile(c, "", "%s (%s)" % (
            dauer(rest * schnitt), t("etwa", monat_jahr(time.time() + rest * schnitt)))))
    if jetzt_btc:
        zeilen.append(zeile(c, t("belohnung"), "%s → %s BTC" % (
            zahl(jetzt_btc, 3), zahl(jetzt_btc / 2, 4))))
    return "\n".join(zeilen), rest, {"height": h, "halvingHeight": ziel, "blocksLeft": rest,
                                      "subsidy": jetzt_btc, "avgBlockSeconds": schnitt}


def cmd_nextblock(lage, args, c):
    proj = lage.felder.get("projected") or []
    zeilen = []
    for i, b in enumerate(proj, 1):
        spanne = b.get("feeRange") or []
        farbe = gebuehr_farbe(b.get("medianFee"))
        zeilen.append("%s %s  %s  %s  %s" % (
            c("#%d" % i, GRAU), c("■", farbe),
            c(gebuehr(b.get("medianFee")) + " sat/vB", farbe, fett=True).ljust(16),
            ("%s tx" % zahl(b.get("nTx"))).rjust(9),
            c("%s … %s" % (gebuehr(spanne[0]), gebuehr(spanne[-1])) if spanne else "", GRAU)))
    median = proj[0].get("medianFee") if proj else None
    return "\n".join(zeilen) or "–", median, proj


