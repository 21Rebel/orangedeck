class Farbe:
    """Farbe nur, wenn sie ankommt: nicht ohne Terminal, nicht bei NO_COLOR
    (no-color.org), nicht bei --color never. Truecolor, wenn das Terminal es
    sagt, sonst der naechste Ton im 256er-Wuerfel."""

    def __init__(self, modus):
        if modus == "always":
            self.an = True
        elif modus == "never":
            self.an = False
        else:
            self.an = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        self.voll = os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit")

    def __call__(self, text, rgb, fett=False):
        if not self.an:
            return text
        if self.voll:
            code = "38;2;%d;%d;%d" % rgb
        else:
            stufen = (0, 95, 135, 175, 215, 255)

            def naechste(v):
                return min(range(6), key=lambda i: abs(stufen[i] - v))

            r, g, b = (naechste(v) for v in rgb)
            code = "38;5;%d" % (16 + 36 * r + 6 * g + b)
        if fett:
            code = "1;" + code
        return "\x1b[%sm%s\x1b[0m" % (code, text)


