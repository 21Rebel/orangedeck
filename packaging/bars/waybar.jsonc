// Ausschnitt fuer ~/.config/waybar/config.jsonc
//
// In "modules-right" (oder -left/-center) den Namen "custom/orangedeck"
// aufnehmen, dann diesen Block danebenstellen.
{
  "custom/orangedeck": {
    "exec": "~/.local/bin/orangedeck --waybar",
    "return-type": "json",
    "interval": 10,
    "tooltip": true,
    // Klick oeffnet das eigene Fenster
    "on-click": "~/.local/bin/orangedeck-window"
  }
}
