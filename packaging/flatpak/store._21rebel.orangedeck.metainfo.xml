<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>store._21rebel.orangedeck</id>
  <name>OrangeDeck</name>
  <summary>Live-Ansicht des Bitcoin-Mempools</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="dev.21rebel">
    <name>21Rebel</name>
  </developer>

  <description>
    <p>
      Der Bitcoin-Mempool als lebendige Kachelgrafik: wartende Transaktionen
      fallen auf die Halde, bestaetigte fliegen in den Block. Dazu eine
      Blockuhr, Kennzahlen zum Schuerfen, ein Blockforscher zum
      Durchblaettern und eine Beobachtung eigener Adressen ohne Schluessel.
    </p>
    <p>
      Die Anwendung ist ein reiner Betrachter. Sie kennt keinen privaten
      Schluessel, kann nicht unterschreiben und traegt keine Bibliothek mit,
      die das koennte. Es gibt keinen eigenen Server, keine Zaehlung, keine
      Absturzberichte und kein Konto.
    </p>
  </description>

  <launchable type="desktop-id">store._21rebel.orangedeck.desktop</launchable>

