<?xml version="1.0" encoding="utf-8"?>
<!-- **updatePeriodMillis kann man nicht unterbieten.** Android rundet alles
     unter 30 Minuten auf 30 Minuten auf; kuerzere Angaben sehen aus wie eine
     Einstellung und sind keine. Wer haeufiger will, braucht einen eigenen
     Wecker oder WorkManager (fruehestens 15 Minuten). Das waere ein zweiter
     Schritt und kostet Akku.

     `resizeMode` erlaubt das Ziehen: die Zahlen sind verschieden lang, und
     ein Widget, das man nicht anpassen kann, passt selten. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_kurs_info"
    android:initialLayout="@layout/widget_deck" />
