<?xml version="1.0" encoding="utf-8"?>
<!-- Die grosse Blockuhr braucht Breite fuer die beiden Fristenzeilen.
     4x2 ist die kleinste Groesse, in der "Halving bei 1 050 000 · noch
     83 733 Bloecke" ungekuerzt steht. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_uhr_gross_info"
    android:initialLayout="@layout/widget_uhr_gross" />
