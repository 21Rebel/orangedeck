<?xml version="1.0" encoding="utf-8"?>
<!-- Die Beschriftungen der Verknuepfungen. **Sie muessen Zeichenketten-
     Ressourcen sein** — anders als das `<intent>` in shortcuts.xml, das
     ausdruecklich keine vertraegt ("This intent element can't include string
     resources").

     Kurz und lang: die kurze steht unter dem Symbol auf dem
     Startbildschirm, die lange im Menue beim langen Druck. Passt die lange
     nicht, faellt der Starter auf die kurze zurueck. -->
<resources>
    <string name="app_name">OrangeDeck</string>

    <string name="shortcut_feed_short">Feed</string>
    <string name="shortcut_feed_long">Mempool-Feed</string>

    <string name="shortcut_clock_short">Uhr</string>
    <string name="shortcut_clock_long">Blockuhr</string>

    <string name="shortcut_explorer_short">Explorer</string>
    <string name="shortcut_explorer_long">Blöcke durchsuchen</string>

    <!-- Die Homescreen-Widgets. Der Name steht in der Auswahlliste des
         Starters, der Text darunter erklaert, was drinsteht. -->
    <string name="widget_uhr">Blockhöhe</string>
    <string name="widget_uhr_info">Höhe und Zeit seit dem letzten Block</string>
    <string name="widget_mempool">Mempool</string>
    <string name="widget_mempool_info">Unbestätigte Transaktionen und Gebühr</string>
    <string name="widget_kurs">Kurs</string>
    <string name="widget_kurs_info">Bitcoin in Euro und Moscow Time</string>
    <string name="widget_miner">Miner</string>
    <string name="widget_miner_info">Hashrate und Temperatur des eigenen Geräts</string>

    <string name="widget_vor_min">vor %1$d Min</string>
    <string name="widget_satvb">%1$s sat/vB</string>
    <string name="widget_bloecke">%1$s Blöcke Rückstau</string>
    <string name="widget_moscow">%1$s sat/€</string>
    <string name="widget_beste">beste %1$s</string>
    <string name="widget_tx">%1$s Transaktionen</string>
    <string name="widget_stufen">schnell %1$s · sparsam %2$s</string>
    <string name="widget_luefter">%1$s U/min</string>
    <string name="widget_tag">%1$s %% in 24 h</string>
    <string name="widget_miner_keine">Adresse nicht gesetzt</string>
    <!-- Steht da, wenn die Abfrage scheitert. Ein Strich statt einer leeren
         Flaeche: leer sieht aus wie ein Fehler des Starters. -->
    <string name="widget_offline">gerade nicht erreichbar</string>
</resources>
