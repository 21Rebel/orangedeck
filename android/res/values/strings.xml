<?xml version="1.0" encoding="utf-8"?>
<!-- **Englisch ist die Rueckfallebene, nicht Deutsch.**

     Android nimmt `res/values/` immer dann, wenn es fuer die Systemsprache
     kein passendes `values-<xx>/` gibt. Bis zum 09.09.2026 stand hier
     Deutsch: ein Telefon auf Spanisch oder Japanisch bekam damit deutsche
     Widgets. Deutsch liegt jetzt in `values-de/`, und wer eine Sprache
     spricht, die wir nicht fuehren, bekommt Englisch.

     **Hier stehen nur noch die Texte, die das Manifest und die XML-Dateien
     brauchen:** Namen und Beschreibungen in der Widget-Auswahl, die
     Verknuepfungen. Und die sind im gebauten Paket immer englisch: Qt setzt
     in der erzeugten build.gradle resConfig 'en' fest und verwirft jede
     andere Sprache, auch values-de. Alles, was ein Widget zur Laufzeit
     schreibt, steht deshalb in Texte.java, in den dreizehn Sprachen der
     Anwendung. Seit dem 10.09.2026; vorher waren die Widgets auch auf einem
     deutschen Telefon englisch.

     values-de bleibt trotzdem liegen: faellt die Beschraenkung einmal weg,
     ist die Widget-Auswahl sofort deutsch.

     Die Beschriftungen der Verknuepfungen muessen Zeichenketten-Ressourcen
     sein, anders als das `<intent>` in shortcuts.xml. -->
<resources>
    <string name="app_name">OrangeDeck</string>

    <string name="shortcut_feed_short">Feed</string>
    <string name="shortcut_feed_long">Mempool feed</string>

    <string name="shortcut_clock_short">Clock</string>
    <string name="shortcut_clock_long">Block clock</string>

    <string name="shortcut_explorer_short">Explorer</string>
    <string name="shortcut_explorer_long">Browse blocks</string>

    <string name="widget_uhr">Block height</string>
    <string name="widget_uhr_info">Height and time since the last block</string>
    <string name="widget_mempool">Mempool</string>
    <string name="widget_mempool_info">Unconfirmed transactions and fee</string>
    <string name="widget_kurs">Price</string>
    <string name="widget_kurs_info">Bitcoin price and Moscow Time</string>
    <string name="widget_miner">Miner</string>
    <string name="widget_miner_info">Hashrate and temperature of your own device</string>

    <string name="widget_uhr_gross">Block clock</string>
    <string name="widget_uhr_gross_info">Block height, price, mempool and both countdowns</string>

    <string name="widget_graph_beschreibung">History</string>
    <string name="widget_kurs_gross_info">Price with history</string>
    <string name="widget_mempool_gross_info">Mempool with blocks</string>
    <string name="widget_miner_gross_info">Miner with hashrate history</string>
</resources>
