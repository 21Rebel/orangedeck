<?xml version="1.0" encoding="utf-8"?>
<!-- Der Grund der Widget-Kachel: dasselbe dunkle Fenster wie in der
     Anwendung, mit denselben runden Ecken wie die Karten darin.

     Kein Durchscheinen. Was hinter einem Widget liegt, ist das
     Hintergrundbild des Anwenders, und Text darauf waere je nach Bild
     unlesbar. Dieselbe Ueberlegung wie bei `bgOpacity` am 04.09.2026.

     Kein Doppelstrich in dieser Datei: er ist in XML-Kommentaren verboten,
     und der Rest des Projekts benutzt ihn als Gedankenstrich. Am 08.09.2026
     zweimal daran gescheitert (appstreamcli, Gradle), am 09.09. hier noch
     einmal. Also Doppelpunkt oder Punkt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#12101a" />
    <corners android:radius="16dp" />
</shape>
