    <string name="widget_luefter">%1$s U/min</string>
    <string name="widget_tag">%1$s %% in 24 h</string>

    <string name="widget_uhr_gross">Blockuhr</string>
    <string name="widget_uhr_gross_info">Blockhöhe, Kurs, Mempool und die beiden Fristen</string>
