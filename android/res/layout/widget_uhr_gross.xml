<?xml version="1.0" encoding="utf-8"?>
<!-- Die grosse Blockuhr, 4x2. Sie zeigt dieselben Werte wie der Reiter "Uhr"
     in der Anwendung: Blockhoehe gross, darunter Kurs, Moscow Time, Mempool
     und Gebuehr, und zuletzt die beiden Fristen (Schwierigkeit, Halving).

     Mehr Zeilen als `widget_deck`, sonst derselbe Aufbau. Kein Doppelstrich
     in Kommentaren: in XML verboten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_grund">

    <TextView
        android:id="@+id/widget_titel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#9a94a6"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_gross"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#f7931a"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_zeile1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="#e8e4f0"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_zeile2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#e8e4f0"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_zeile3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#e8e4f0"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_zeile4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#9a94a6"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_zeile5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#9a94a6"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
