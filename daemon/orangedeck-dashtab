def fail(msg):
    print("FEHLER: " + msg, file=sys.stderr)
    sys.exit(1)


def patch_settings(text):
    old = 'readonly property var _dashTabIds: ["overview", "media", "wallpaper", "weather", "settings"]'
    new = 'readonly property var _dashTabIds: ["overview", "media", "wallpaper", "weather", "bitcoin", "settings"]'
    if new in text:
        return text
    if old not in text:
        fail("Ankerpunkt in SettingsData.qml nicht gefunden -- DMS hat sich geaendert.\n"
             "       Gesucht wurde: " + old)
    return text.replace(old, new)


def patch_ipc(text):
    """`dms ipc call dash open bitcoin` und Tastenkuerzel sollen den Tab treffen."""
    if 'case "bitcoin":' in text:
        return text
    old = """            case "weather":
                return "weather";
"""
    new = """            case "weather":
                return "weather";
            case "bitcoin":
                return "bitcoin";
"""
    if old not in text:
        fail("Ankerpunkt in DMSShellIPC.qml nicht gefunden -- DMS hat sich geaendert.")
    return text.replace(old, new, 1)


def patch_popout(text):
    if '"bitcoin"' in text:
        return text

    anchors = [
        # 1. Tab in der Leiste
        ('''            "settings": {
                "icon": "settings",''',
         '''            "bitcoin": {
                "icon": "currency_bitcoin",
                "text": "Bitcoin"
            },
            "settings": {
                "icon": "settings",'''),
        # 2. Hoehe der Seite
        ('''                        if (root.currentTabId === "weather")
                            return weatherLoader.item?.implicitHeight ?? 410;
                        return 410;''',
         '''                        if (root.currentTabId === "weather")
                            return weatherLoader.item?.implicitHeight ?? 410;
                        if (root.currentTabId === "bitcoin")
                            return bitcoinLoader.item?.implicitHeight ?? 410;
                        return 410;'''),
        # 3. aktuelle Seite
        ('''                        if (root.currentTabId === "weather")
                            return weatherLoader.item;
                        return null;''',
         '''                        if (root.currentTabId === "weather")
                            return weatherLoader.item;
                        if (root.currentTabId === "bitcoin")
                            return bitcoinLoader.item;
                        return null;'''),
        # 4. Loader fuer den Inhalt
        ('''                    Loader {
                        id: overviewLoader''',
         '''                    Loader {
                        id: bitcoinLoader
                        anchors.fill: parent
                        active: root.currentTabId === "bitcoin"
                        visible: active
                        sourceComponent: Component {
                            BitcoinTab {}
                        }
                        // `Item.visible` bleibt wahr, wenn das Popout-Fenster
                        // schliesst -- die Sichtbarkeit eines Fensters ist
                        // keine Eigenschaft der Elementkette. Der Popout weiss
                        // es aber selbst, also wird es durchgereicht.
                        onLoaded: {
                            if (item)
                                item.live = Qt.binding(function () {
                                    return root.dashVisible;
                                });
                        }
                    }

                    Loader {
                        id: overviewLoader'''),
    ]
    for old, new in anchors:
        if old not in text:
            fail("Ankerpunkt in DankDashPopout.qml nicht gefunden -- DMS hat sich geaendert.\\n"
                 "       Gesucht wurde:\\n" + old)
        text = text.replace(old, new, 1)
    return text


def mirror(rel):
    """Legt ein Verzeichnis als Symlink-Spiegel des Originals an."""
    src = os.path.join(SRC, rel) if rel else SRC
    dst = os.path.join(DST, rel) if rel else DST
    os.makedirs(dst, exist_ok=True)
    for name in sorted(os.listdir(src)):
        sub = os.path.join(rel, name) if rel else name
        target = os.path.join(dst, name)
        if os.path.islink(target) or os.path.exists(target):
            continue
        if sub in MIRROR:
            mirror(sub)
        else:
            os.symlink(os.path.join(src, name), target)


def build():
    if not os.path.isdir(SRC):
        fail("DMS nicht gefunden unter " + SRC)
    if os.path.exists(DST):
        shutil.rmtree(DST)
    mirror("")

    # gepatchte Dateien als echte Kopien
    dash = os.path.join(DST, "Modules", "DankDash")
    for name, patcher, sub in (
        ("SettingsData.qml", patch_settings, "Common"),
        ("DankDashPopout.qml", patch_popout, os.path.join("Modules", "DankDash")),
        ("DMSShellIPC.qml", patch_ipc, ""),
    ):
        path = os.path.join(DST, sub, name) if sub else os.path.join(DST, name)
        if os.path.islink(path):
            os.unlink(path)
        with open(os.path.join(SRC, sub, name) if sub else os.path.join(SRC, name)) as f:
            text = f.read()
        with open(path, "w") as f:
            f.write(patcher(text))

    # Tab-Inhalt und die geteilten Bausteine daneben legen
    with open(os.path.join(dash, "BitcoinTab.qml"), "w") as f:
        f.write(BITCOIN_TAB)
    # Bewusst aus dem Verzeichnis gelesen statt aufgezaehlt: eine fest
    # verdrahtete Liste vergisst man beim naechsten neuen Baustein, und dann
    # laesst sich FeedPanel hier nicht mehr laden -- der Bitcoin-Tab scheitert
    # und mit ihm das ganze Dashboard. Genau so am 01.09.2026 passiert, als
    # FrostedPanel.qml dazukam.
    for name in sorted(os.listdir(QML)):
        if not (name.endswith(".qml") or name.endswith(".js")):
            continue
        link = os.path.join(dash, name)
        if os.path.islink(link):
            os.unlink(link)
        os.symlink(os.path.join(QML, name), link)

    # systemd-Drop-in
    os.makedirs(DROPIN_DIR, exist_ok=True)
    with open(DROPIN, "w") as f:
        f.write("# Von orangedeck-dashtab angelegt: DMS aus der Ueberlagerung starten\n"
                "[Service]\nExecStart=\n"
                "ExecStart=/usr/bin/dms run --session -c %s\n" % DST)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    print("Ueberlagerung liegt in " + DST)
    print("Neu starten mit:  systemctl --user restart dms")


def remove():
    if os.path.exists(DROPIN):
        os.unlink(DROPIN)
    if os.path.exists(DST):
        shutil.rmtree(DST)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    print("Ueberlagerung entfernt. Neu starten mit:  systemctl --user restart dms")


def check():
    if not os.path.isdir(DST):
        print("keine Ueberlagerung eingerichtet")
        return 1
    ok = True
    for sub, name in (("Common", "SettingsData.qml"),
                      (os.path.join("Modules", "DankDash"), "DankDashPopout.qml"),
                      ("", "DMSShellIPC.qml")):
        mine = os.path.join(DST, sub, name) if sub else os.path.join(DST, name)
        orig = os.path.join(SRC, sub, name) if sub else os.path.join(SRC, name)
        if os.path.getmtime(orig) > os.path.getmtime(mine):
            print("veraltet: %s ist neuer als die gepatchte Kopie" % orig)
            ok = False
    print("Ueberlagerung aktuell" if ok else "orangedeck-dashtab erneut aufrufen")
    return 0 if ok else 1


if __name__ == "__main__":
    if "--remove" in sys.argv:
        remove()
    elif "--check" in sys.argv:
        sys.exit(check())
    else:
        build()
