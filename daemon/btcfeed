HOST = "mempool.space"
WS_URL = f"wss://{HOST}/api/v1/ws"
API = f"https://{HOST}/api"
# Der Zustand wird mehrmals pro Sekunde neu geschrieben und muss einen Neustart
# nicht ueberleben -- er gehoert deshalb ins tmpfs, nicht auf die SSD.
STATE_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR")
                         or os.path.expanduser("~/.local/state"), "btcfeed")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
BLOCK_FILE = os.path.join(STATE_DIR, "block.json")
LOCK_FILE = os.path.join(STATE_DIR, "btcfeed.lock")

WRITE_INTERVAL = 0.4      # Sekunden zwischen zwei Schreibvorgaengen
RECENT_KEEP = 120         # wie viele frische TX im Zustand liegen bleiben
MAX_TILES = 8000          # Obergrenze an Kacheln pro Block

# Gebuehrenklassen fuer die Kachelfarben. Der Index landet als Ziffer in
# block.json, die Ansicht rechnet ihn ueber dieselbe Tabelle zurueck.
FEE_BUCKETS = [0.5, 1, 2, 3, 5, 8, 15, 30, 80]

# Loopback-Schnittstelle fuer die Oberflaechen.
#
# Warum ueberhaupt ein Port, wo doch state.json existiert: Qt sperrt lesenden
# Dateizugriff per XMLHttpRequest hinter QML_XHR_ALLOW_FILE_READ=1 (am
# 01.09.2026 nachgemessen -- ohne die Variable bleibt der Aufruf auf
# readyState 1 stehen). Ueber HTTP geht es ohne Sonderfall, auf jedem Desktop
# und unter Android gleichermassen. Die Dateien werden weiter geschrieben.
#
# **Standard ist 127.0.0.1.** Die Daten bleiben auf dem Geraet des Benutzers;
# nichts wird nach aussen angeboten, solange BTCFEED_ADDR nicht ausdruecklich
# geaendert wird. Fuer ein Tablet im eigenen Netz ist das eine bewusste
# Entscheidung, kein Standardverhalten.
SERVE_ADDR = os.environ.get("BTCFEED_ADDR", "127.0.0.1")
SERVE_PORT = int(os.environ.get("BTCFEED_PORT", "21021"))

# Zusaetzliche Quellen. Jede ist einzeln abschaltbar, indem man sie weglaesst.
#
#   ~/.config/btcfeed/sources.json
#   {
#     "miners": [
#       { "type": "axeos",   "url": "http://192.168.100.42" },
#       { "type": "cgminer", "host": "192.168.100.50", "port": 4028 }
#     ]
#   }
#
# `"bitaxe": "http://..."` wird als Kurzform weiter gelesen.
#
# Die Adressen stammen ueblicherweise aus DHCP und aendern sich. Deshalb gibt
# es `btcfeed --discover-miners`, das das eigene Netz absucht. Der Daemon sucht
# **nicht** von selbst -- ein Suchlauf ueber das ganze Netz gehoert nicht in
# einen Dienst, der im Hintergrund laeuft.
#
# Die Datei ist bewusst getrennt von btcfeed.conf, die den QSettings der
# Anwendung gehoert.
SOURCES_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "btcfeed", "sources.json")


def load_sources():
    cfg = {}
    try:
        with open(SOURCES_FILE) as f:
            cfg = json.load(f) or {}
    except Exception:
        pass

    miners = list(cfg.get("miners") or [])
    # Kurzform und Umgebungsvariable einreihen
    for short in (cfg.get("bitaxe"), os.environ.get("BTCFEED_MINER"),
                  os.environ.get("BTCFEED_BITAXE")):
        if short:
            miners.append({"type": "axeos", "url": short})
    # Doppelte entfernen, Reihenfolge erhalten
    seen, out = set(), []
    for m in miners:
        key = (m.get("type"), m.get("url"), m.get("host"), m.get("port"))
        if key not in seen:
            seen.add(key)
            out.append(m)
    cfg["miners"] = out
    return cfg


SOURCES = load_sources()

# Wie oft die langsamen Kennzahlen geholt werden. Schwierigkeit und Hashrate
# aendern sich im Stunden- bis Tagestakt -- alle fuenf Minuten ist reichlich.
SLOW_INTERVAL = 300
MINER_INTERVAL = 5


def fee_bucket(rate):
    r = rate or 0
    for i, edge in enumerate(FEE_BUCKETS):
        if r < edge:
            return i
    return len(FEE_BUCKETS)


def tile_size(value_sats):
    """Kantenlaenge in Rastereinheiten -- identisch zu logTxSize() in bitfeed."""
    v = max(1, int(value_sats or 1))
    return min(5, max(1, math.ceil(math.log10(v)) - 5))
UA = "btcfeed/1.0 (+https://mempool.space)"


# --------------------------------------------------------------------------
# Minimaler WebSocket-Client (RFC 6455, nur was hier gebraucht wird)
# --------------------------------------------------------------------------
class WSError(Exception):
    pass


class WebSocket:
    def __init__(self, url, origin=None, timeout=45):
        u = urlparse(url)
        secure = u.scheme in ("wss", "https")
        port = u.port or (443 if secure else 80)
        path = (u.path or "/") + (("?" + u.query) if u.query else "")
        self._buf = b""
        raw = socket.create_connection((u.hostname, port), timeout=20)
        raw.settimeout(timeout)
        if secure:
            self.sock = ssl.create_default_context().wrap_socket(
                raw, server_hostname=u.hostname)
        else:
            self.sock = raw
        key = base64.b64encode(os.urandom(16)).decode()
        req = (f"GET {path} HTTP/1.1\r\nHost: {u.hostname}\r\n"
               "Upgrade: websocket\r\nConnection: Upgrade\r\n"
               f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n"
               f"User-Agent: {UA}\r\n"
               + (f"Origin: {origin}\r\n" if origin else "") + "\r\n")
        self.sock.sendall(req.encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise WSError("Verbindung beim Handshake geschlossen")
            head += chunk
            if len(head) > 65536:
                raise WSError("Handshake-Antwort zu gross")
        header, _, rest = head.partition(b"\r\n\r\n")
        status = header.split(b"\r\n", 1)[0].decode(errors="replace")
        if "101" not in status:
            raise WSError(f"Handshake fehlgeschlagen: {status}")
        accept = base64.b64encode(hashlib.sha1(
            (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        if accept.encode() not in header:
            raise WSError("Sec-WebSocket-Accept passt nicht")
        self._buf = rest

    def _read(self, n):
        while len(self._buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise WSError("Verbindung geschlossen")
            self._buf += chunk
        out, self._buf = self._buf[:n], self._buf[n:]
        return out

    def _frame(self, opcode, payload=b""):
        n = len(payload)
        head = bytes([0x80 | opcode])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        self.sock.sendall(head + mask
                          + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def send(self, text):
        self._frame(0x1, text.encode())

    def recv(self):
        """Naechster Textrahmen als str; Ping/Close werden intern behandelt."""
        frags, frag_op = [], None
        while True:
            b0, b1 = self._read(2)
            fin, opcode, n = b0 & 0x80, b0 & 0x0F, b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            if b1 & 0x80:
                mask = self._read(4)
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(self._read(n)))
            else:
                data = self._read(n)
            if opcode == 0x8:
                self._frame(0x8, data[:2])
                raise WSError("Server hat die Verbindung geschlossen")
            if opcode == 0x9:
                self._frame(0xA, data)
                continue
            if opcode == 0xA:
                continue
            if opcode == 0x0:
                frags.append(data)
            else:
                frags, frag_op = [data], opcode
            if fin:
                return b"".join(frags).decode("utf-8", "replace") if frag_op == 0x1 else None

    def close(self):
        try:
            self._frame(0x8, struct.pack(">H", 1000))
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass


def write_block_summary(tip):
    """Holt die Transaktionsliste des Blocks und legt die Kacheldaten ab.

    Aus jeder Transaktion werden nur zwei Ziffern gespeichert: Kantenlaenge
    (1-5) und Gebuehrenklasse (0-9). Ein voller Block sind damit rund 8 kB
    statt 700 kB. Die Reihenfolge bleibt die des Blocks."""
    bid = tip.get("id")
    if not bid:
        return
    txs = http_json("/v1/block/%s/summary" % bid, timeout=40)
    if not isinstance(txs, list) or not txs:
        return

    step = max(1, len(txs) // MAX_TILES + (1 if len(txs) % MAX_TILES else 0))
    tiles = []
    total_value = 0
    total_fee = 0
    total_vsize = 0.0
    for t in txs:
        total_value += int(t.get("value") or 0)
        total_fee += int(t.get("fee") or 0)
        total_vsize += float(t.get("vsize") or 0)
    # Kacheln (zwei Ziffern je Transaktion) und die Angaben fuer den Tooltip.
    # Beide werden mit demselben Schritt abgetastet, damit die Indizes passen.
    details = []
    for t in txs[::step]:
        tiles.append("%d%d" % (tile_size(t.get("value")), fee_bucket(t.get("rate"))))
        details.append([
            t.get("txid") or "",
            round(float(t.get("vsize") or 0), 2),
            int(t.get("fee") or 0),
            int(t.get("value") or 0),
            round(float(t.get("rate") or 0), 3),
        ])

    data = dict(tip)
    data.update({
        "totalValue": total_value,
        "sumFees": total_fee,
        "avgFeeRate": round(total_fee / total_vsize, 3) if total_vsize else 0,
        "tileStep": step,
        "tiles": "".join(tiles),
        "txs": details,
    })
    tmp = BLOCK_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, separators=(",", ":"))
    os.replace(tmp, BLOCK_FILE)


def http_json(path, timeout=15):
    req = urllib.request.Request(API + path, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


# --------------------------------------------------------------------------
# Zustand
# --------------------------------------------------------------------------
class Feed:
    def __init__(self):
        self.seq = 0
        self.recent = []          # juengste TX, aelteste zuerst
        self.mempool = {"count": 0, "vsize": 0, "totalFee": 0}
        self.fees = {}
        self.vbps = 0
        self.next_block = {}
        self.tip = {}
        self.price = {}
        self.block_event = 0      # Zeitstempel des zuletzt gesehenen Blocks
        self.source = "start"
        self.error = ""
        self.dirty = True
        self.summary_for = None
        # Langsame Kennzahlen fuer die BlockClock, und der eigene Miner
        self.difficulty = {}
        self.hashrate = {}
        self.miners = []          # je Geraet ein normalisierter Satz Felder
        self.miner_total = {}     # Summe ueber alle erreichbaren Geraete
        self.slow_at = 0.0
        self.miner_at = 0.0

    # -- Einspeisung ------------------------------------------------------
    def add_txs(self, txs):
        for t in txs:
            try:
                rate = t.get("rate")
                vsize = float(t.get("vsize") or 0) or 1.0
                if rate is None:
                    rate = float(t.get("fee") or 0) / vsize
                self.seq += 1
                self.recent.append({
                    "n": self.seq,
                    "t": t.get("txid") or "",     # voll, fuer den Tooltip
                    "v": round(vsize, 1),
                    "r": round(float(rate), 3),
                    "a": int(t.get("value") or 0),
                    "f": int(t.get("fee") or 0),
                })
            except (TypeError, ValueError):
                continue
        if len(self.recent) > RECENT_KEEP:
            self.recent = self.recent[-RECENT_KEEP:]
        self.dirty = True

    def set_mempool(self, info):
        self.mempool = {
            "count": int(info.get("size") or 0),
            "vsize": int(info.get("bytes") or 0),
            "totalFee": round(float(info.get("total_fee") or 0) * 1e8),
        }
        self.dirty = True

    def set_next_block(self, blocks):
        if not blocks:
            return
        b = blocks[0]
        self.next_block = {
            "nTx": int(b.get("nTx") or 0),
            "vsize": round(float(b.get("blockVSize") or 0)),
            "medianFee": round(float(b.get("medianFee") or 0), 2),
            "totalFees": int(b.get("totalFees") or 0),
            "depth": len(blocks),
        }
        self.dirty = True

    def set_tip(self, b, is_new=False):
        if not b:
            return
        height = int(b.get("height") or 0)
        if height and height == self.tip.get("height") and not is_new:
            return
        ex = b.get("extras") or {}
        pool = (ex.get("pool") or {}).get("name") or ""
        self.tip = {
            "height": height,
            "id": b.get("id") or "",
            "time": int(b.get("timestamp") or 0),
            "nTx": int(b.get("tx_count") or 0),
            "size": int(b.get("size") or 0),
            "weight": int(b.get("weight") or 0),
            "medianFee": round(float(ex.get("medianFee") or 0), 2),
            "totalFees": int(ex.get("totalFees") or 0),
            "reward": int(ex.get("reward") or 0),
            "pool": pool,
        }
        if is_new:
            self.block_event = time.time()
        self.dirty = True
        self.request_summary()

    def request_summary(self):
        """Kacheldaten des aktuellen Blocks nachladen, ohne den Socket zu blockieren."""
        bid = self.tip.get("id")
        if not bid or bid == self.summary_for:
            return
        self.summary_for = bid
        tip = dict(self.tip)

        def work():
            try:
                write_block_summary(tip)
            except Exception as e:
                sys.stderr.write("Blockzusammenfassung fehlgeschlagen: %s\n" % e)
                if self.summary_for == tip.get("id"):
                    self.summary_for = None

        threading.Thread(target=work, daemon=True).start()

    # -- Ausgabe ----------------------------------------------------------
    def snapshot(self):
        return {
            "ts": round(time.time(), 2),
            "source": self.source,
            "error": self.error,
            "mempool": self.mempool,
            "fees": self.fees,
            "vbps": self.vbps,
            "nextBlock": self.next_block,
            "tip": self.tip,
            "price": self.price,
            "blockEvent": round(self.block_event, 2),
            "seq": self.seq,
            "recent": self.recent[-RECENT_KEEP:],
            "difficulty": self.difficulty,
            "hashrate": self.hashrate,
            "miners": self.miners,
            "minerTotal": self.miner_total,
        }

    def write(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.snapshot(), f, separators=(",", ":"))
        os.replace(tmp, STATE_FILE)
        self.dirty = False


# --------------------------------------------------------------------------
# Loopback-Schnittstelle
# --------------------------------------------------------------------------
class _Handler(BaseHTTPRequestHandler):
    """Nur lesend, nur GET, nur die drei Pfade. Kein Zustand wird entgegen-
    genommen -- der Dienst nimmt grundsaetzlich nichts an."""

    protocol_version = "HTTP/1.1"
    feed = None

    def _send(self, body, status=200, ctype="application/json"):
        raw = body if isinstance(body, bytes) else body.encode()
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        path = urlparse(self.path).path
        try:
            if path == "/state":
                self._send(json.dumps(self.feed.snapshot(), separators=(",", ":")))
            elif path == "/block":
                try:
                    with open(BLOCK_FILE, "rb") as f:
                        self._send(f.read())
                except FileNotFoundError:
                    self._send("{}")
            elif path == "/health":
                self._send(json.dumps({"ok": True, "source": self.feed.source}))
            else:
                self._send('{"error":"unbekannter Pfad"}', 404)
        except BrokenPipeError:
            pass
        except Exception as e:
            try:
                self._send(json.dumps({"error": str(e)}), 500)
            except Exception:
                pass

    def log_message(self, *a):
        pass   # sonst eine Zeile je Abfrage, mehrmals pro Sekunde


def serve_local(feed):
    """Startet die Loopback-Schnittstelle. Scheitert sie, laeuft der Feed
    trotzdem weiter -- die Dateien werden ja nach wie vor geschrieben."""
    handler = type("Handler", (_Handler,), {"feed": feed})
    try:
        srv = ThreadingHTTPServer((SERVE_ADDR, SERVE_PORT), handler)
    except OSError as e:
        sys.stderr.write("Loopback-Schnittstelle nicht gestartet (%s:%s): %s\n"
                         % (SERVE_ADDR, SERVE_PORT, e))
        return None
    srv.daemon_threads = True
    if SERVE_ADDR not in ("127.0.0.1", "::1", "localhost"):
        sys.stderr.write("WARNUNG: btcfeed ist auf %s erreichbar, nicht nur lokal.\n"
                         % SERVE_ADDR)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


def poll_slow(feed):
    """Schwierigkeitsanpassung und Hashrate. Beides aendert sich langsam und
    wird deshalb nur alle paar Minuten geholt -- es speist die BlockClock und
    den Vergleich mit der Netzschwierigkeit in der Miner-Ansicht."""
    if time.time() - feed.slow_at < SLOW_INTERVAL:
        return
    feed.slow_at = time.time()
    try:
        d = http_json("/v1/difficulty-adjustment")
        feed.difficulty = {
            "progress": d.get("progressPercent"),
            "change": d.get("difficultyChange"),
            "remainingBlocks": d.get("remainingBlocks"),
            "remainingTime": d.get("remainingTime"),
            "nextHeight": d.get("nextRetargetHeight"),
            "previousChange": d.get("previousRetarget"),
        }
        feed.dirty = True
    except Exception as e:
        sys.stderr.write("Schwierigkeit: %s\n" % e)
    try:
        # /3d liefert nur drei Messpunkte -- zu wenig fuer eine Kurve.
        # /1m sind 31 Punkte bei 2,2 kB, alle fuenf Minuten geholt.
        h = http_json("/v1/mining/hashrate/1m")
        feed.hashrate = {
            "current": h.get("currentHashrate"),
            "difficulty": h.get("currentDifficulty"),
            "series": [p.get("avgHashrate") for p in (h.get("hashrates") or [])][-40:],
        }
        feed.dirty = True
    except Exception as e:
        sys.stderr.write("Hashrate: %s\n" % e)


# --------------------------------------------------------------------------
# Miner
# --------------------------------------------------------------------------
# Zwei Protokollfamilien decken praktisch alle ueblichen Geraete ab:
#
#   axeos    HTTP, /api/system/info -- Bitaxe, NerdAxe und die uebrigen
#            ESP-Miner-Abkoemmlinge (AxeOS)
#   cgminer  TCP 4028 mit JSON-Befehlen -- die klassische cgminer-Schnittstelle,
#            die Antminer, Avalon, Whatsminer und viele Nachbauten sprechen
#
# Alle Adapter liefern denselben Satz Felder zurueck, Hashrate immer in H/s.
# Die Ansicht muss dadurch nichts ueber das Geraet wissen.

def parse_diff(v):
    """'1.23M' -> 1230000.0. Die Geraete melden die Bestleistung als Text
    mit Einheit."""
    if isinstance(v, (int, float)):
        return float(v)
    if not v:
        return 0.0
    t = str(v).strip()
    mult = {"k": 1e3, "K": 1e3, "M": 1e6, "G": 1e9, "T": 1e12, "P": 1e15, "E": 1e18}
    f = mult.get(t[-1:], 1.0)
    try:
        return float(t if f == 1.0 else t[:-1]) * f
    except ValueError:
        return 0.0


def probe_axeos(url, timeout=4):
    req = urllib.request.Request(url.rstrip("/") + "/api/system/info",
                                 headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.loads(r.read().decode())
    return {
        "type": "axeos",
        "id": url,
        "name": d.get("hostname") or d.get("ASICModel") or d.get("boardVersion") or "AxeOS",
        "model": d.get("ASICModel") or d.get("boardVersion") or "",
        "online": True,
        # AxeOS meldet GH/s
        "hashRate": float(d.get("hashRate") or 0) * 1e9,
        "bestDiff": parse_diff(d.get("bestDiff")),
        "bestSessionDiff": parse_diff(d.get("bestSessionDiff")),
        "temp": d.get("temp"),
        "power": d.get("power"),
        "shares": d.get("sharesAccepted"),
        "rejected": d.get("sharesRejected"),
        "uptime": d.get("uptimeSeconds"),
    }


def cgminer_call(host, port, command, timeout=3):
    """Die cgminer-Schnittstelle antwortet mit JSON, haengt aber gern ein
    Nullbyte an und liefert kein Content-Length -- also bis zum Verbindungsende
    lesen und hinten abschneiden."""
    with socket.create_connection((host, int(port)), timeout=timeout) as sk:
        sk.settimeout(timeout)
        sk.sendall(json.dumps({"command": command}).encode())
        buf = b""
        while True:
            try:
                chunk = sk.recv(4096)
            except socket.timeout:
                break
            if not chunk:
                break
            buf += chunk
    return json.loads(buf.rstrip(b"\x00").decode(errors="replace"))


def probe_cgminer(host, port=4028, timeout=3):
    d = cgminer_call(host, port, "summary", timeout)
    row = (d.get("SUMMARY") or [{}])[0]

    def num(*keys):
        for k in keys:
            if row.get(k) is not None:
                try:
                    return float(row[k])
                except (TypeError, ValueError):
                    pass
        return None

    mhs = num("MHS av", "MHS 5s", "MHS 1m") or 0.0
    return {
        "type": "cgminer",
        "id": "%s:%s" % (host, port),
        "name": host,
        "model": (d.get("STATUS") or [{}])[0].get("Description") or "",
        "online": True,
        "hashRate": mhs * 1e6,          # cgminer meldet MH/s
        "bestDiff": parse_diff(row.get("Best Share")),
        "bestSessionDiff": 0.0,
        "temp": num("Temperature"),
        "power": None,
        "shares": int(num("Accepted") or 0),
        "rejected": int(num("Rejected") or 0),
        "uptime": int(num("Elapsed") or 0),
    }


def probe_miner(spec, timeout=4):
    """Fragt ein einzelnes Geraet ab. Nicht erreichbar ist **kein Fehler**,
    sondern ein Zustand -- die Geraete sind oft schlicht aus."""
    kind = (spec.get("type") or "axeos").lower()
    try:
        if kind == "cgminer":
            return probe_cgminer(spec.get("host"), spec.get("port", 4028), timeout)
        return probe_axeos(spec.get("url") or spec.get("host") or "", timeout)
    except Exception as e:
        return {
            "type": kind,
            "id": spec.get("url") or "%s:%s" % (spec.get("host"), spec.get("port", 4028)),
            "name": spec.get("name") or spec.get("host") or spec.get("url") or "Miner",
            "online": False,
            "error": str(e),
        }


def poll_miners(feed):
    """Alle eingetragenen Geraete. Ohne Eintrag passiert hier gar nichts."""
    specs = SOURCES.get("miners") or []
    if not specs or time.time() - feed.miner_at < MINER_INTERVAL:
        return
    feed.miner_at = time.time()
    found = [probe_miner(sp) for sp in specs]
    live = [m for m in found if m.get("online")]
    feed.miners = found
    feed.miner_total = {
        "count": len(found),
        "online": len(live),
        "hashRate": sum(m.get("hashRate") or 0 for m in live),
        "bestDiff": max([m.get("bestDiff") or 0 for m in live] or [0]),
    }
    feed.dirty = True


def local_networks():
    """Die eigenen /24-Netze. Virtuelle Bruecken (libvirt, Docker) bleiben
    draussen -- dort steht kein Miner."""
    out = []
    try:
        res = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=5)
        for line in res.stdout.splitlines():
            parts = line.split()
            if len(parts) < 4:
                continue
            dev, cidr = parts[1], parts[3]
            if dev.startswith(("virbr", "docker", "br-", "veth", "tun", "tailscale")):
                continue
            addr, _, bits = cidr.partition("/")
            if bits != "24":
                continue
            out.append((dev, addr.rsplit(".", 1)[0]))
    except Exception:
        pass
    return out


def discover_miners(timeout=1.0, workers=64):
    """Sucht im eigenen Netz nach Minern. Bewusst **nur** auf Zuruf: ein
    Suchlauf ueber alle Adressen gehoert nicht in einen Hintergrunddienst.

    Die Geraete haengen ueblicherweise im WLAN und bekommen ihre Adresse per
    DHCP -- eine fest eingetragene Adresse haelt daher selten lange."""
    import queue
    found, q = [], queue.Queue()
    lock = threading.Lock()

    for dev, prefix in local_networks():
        for i in range(1, 255):
            q.put((dev, "%s.%d" % (prefix, i)))

    def worker():
        while True:
            try:
                dev, ip = q.get_nowait()
            except Exception:
                return
            # AxeOS ueber HTTP
            try:
                m = probe_axeos("http://" + ip, timeout=timeout)
                m["via"] = dev
                with lock:
                    found.append(m)
                q.task_done()
                continue
            except Exception:
                pass
            # cgminer ueber TCP 4028
            try:
                m = probe_cgminer(ip, 4028, timeout=timeout)
                m["via"] = dev
                with lock:
                    found.append(m)
            except Exception:
                pass
            q.task_done()

    threads = [threading.Thread(target=worker, daemon=True) for _ in range(workers)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return found


def cmd_discover(write=False):
    nets = local_networks()
    if not nets:
        print("Kein eigenes /24-Netz gefunden.", file=sys.stderr)
        return 1
    print("Suche in: %s" % ", ".join("%s (%s.0/24)" % (d, p) for d, p in nets),
          file=sys.stderr)
    found = discover_miners()
    if not found:
        print("Kein Miner gefunden. Laeuft das Geraet, und haengt es im selben Netz?",
              file=sys.stderr)
        return 1
    for m in found:
        print("  %-22s %-8s %-18s %s" % (
            m["id"], m["type"], m.get("name") or "",
            ("%.2f TH/s" % (m["hashRate"] / 1e12)) if m.get("hashRate") else ""))
    if write:
        specs = []
        for m in found:
            if m["type"] == "axeos":
                specs.append({"type": "axeos", "url": m["id"]})
            else:
                host, _, port = m["id"].partition(":")
                specs.append({"type": "cgminer", "host": host, "port": int(port or 4028)})
        cfg = {}
        try:
            with open(SOURCES_FILE) as f:
                cfg = json.load(f) or {}
        except Exception:
            pass
        cfg["miners"] = specs
        os.makedirs(os.path.dirname(SOURCES_FILE), exist_ok=True)
        with open(SOURCES_FILE, "w") as f:
            json.dump(cfg, f, indent=2)
        print("\nIn %s eingetragen. Uebernehmen mit:\n"
              "  systemctl --user restart btcfeed" % SOURCES_FILE, file=sys.stderr)
    else:
        print("\nMit --write in %s eintragen." % SOURCES_FILE, file=sys.stderr)
    return 0


